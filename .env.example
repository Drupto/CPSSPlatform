# ---------------------------------------------------------------------------
# KINÉTIKA / CPSSPlatform — environment example
# Copy to .env.local for local development, or set in your hosting provider.
# ---------------------------------------------------------------------------
# 🔴 NEVER commit real values. `.env*` is gitignored. All variables below are
# NEXT_PUBLIC_* (safe for the client bundle) — keep any future server-only
# secret OUT of NEXT_PUBLIC_* scope.

# --- Firebase (public-safe: the web API key is not a secret) ----------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:123:web:abc
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXX

# --- Site -------------------------------------------------------------------
# Public origin used for metadataBase, canonical URLs, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://learnkinetika.com

# Server-side Admin SDK (used by src/lib/firebase-admin.ts for sitemap /
# metadata). On Firebase App Hosting / Cloud Run the runtime service account
# is used automatically; otherwise provide ONE of the two — they are NOT
# interchangeable:
#
#   1) Local dev (key file on disk) — a FILE PATH. The ADC chain reads this
#      automatically; no code change needed:
#        GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
#   2) Netlify / CI (no filesystem) — the ENTIRE JSON file contents pasted
#      inline as the value. NEVER a file path: a path here fails JSON.parse()
#      in firebase-admin.ts and silently degrades to ADC, surfacing later as
#      "Could not load the default credentials" at query time:
#        GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
#
# Keep key files out of git (see .gitignore: *adminsdk*.json).

# --- Emulator support -------------------------------------------------------
# Set to "true" when using `firebase emulators:start`
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
