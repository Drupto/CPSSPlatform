rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myRole() {
      return myProfile().data.role;
    }
    function getDoc(path) {
      return get(/databases/$(database)/documents/$(path));
    }
    // Platform owner
    function isSuper() {
      return signedIn() && myRole() == 'super';
    }
    // Coaching institute account
    function isInstitute() {
      return signedIn() && myRole() == 'institute';
    }
    function isStudent() {
      return signedIn() && myRole() == 'student';
    }
    // A user belongs to an institute when profile.instituteId matches OR is active member.
    function belongsToInstitute(instituteId) {
      return isInstitute() && myProfile().data.instituteId == instituteId;
    }
    function isInstituteOwner(instituteId) {
      return belongsToInstitute(instituteId)
        && getDoc('institutes/' + instituteId).data.ownerUid == request.auth.uid;
    }
    function isActiveMember(instituteId) {
      return signedIn()
        && getDoc('institutes/' + instituteId + '/members/' + request.auth.uid).data.status == 'active';
    }
    function canManageInstitute(instituteId) {
      return isSuper() || isInstituteOwner(instituteId) || isActiveMember(instituteId);
    }
    function courseInstituteId(courseId) {
      return getDoc('courses/' + courseId).data.instituteId;
    }
    function coursePublished(courseId) {
      return getDoc('courses/' + courseId).data.published == true;
    }
    // Can manage a specific existing course (by id)
    function canManageCourseId(courseId) {
      return isSuper() || belongsToInstitute(courseInstituteId(courseId));
    }
    // Can manage a course payload (by its requested instituteId)
    function canManageCourseData(data) {
      return isSuper() || (isInstitute() && myProfile().data.instituteId == data.instituteId);
    }
    function isValidQuizData(data) {
      return data is map
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.description is string
        && data.description.size() <= 2000
        && data.passPercentage is int
        && data.passPercentage >= 0
        && data.passPercentage <= 100
        && data.maxAttempts is int
        && data.maxAttempts >= 1
        && data.maxAttempts <= 100
        && data.randomizeQuestionOrder is bool
        && data.randomizeAnswerOrder is bool
        && data.questions is list
        && data.questions.size() >= 1
        && data.questions.size() <= 100
        && (!('timeLimit' in data) || (data.timeLimit is int && data.timeLimit >= 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }
    // Pretend a user is authorized to run any course-side admin read (owner or super).
    function canReadCourseAdmin(courseId) {
      return isSuper() || (isInstitute() && myProfile().data.instituteId == courseInstituteId(courseId));
    }

    // ------------------------------------------------------------------
    // users
    // ------------------------------------------------------------------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuper());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student';
      // A user may only update their own display fields. Role/instituteId are
      // managed exclusively by Cloud Functions (Admin SDK, which bypasses rules).
      allow update: if signedIn()
        && (
          (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt']))
          || isSuper()
        );
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // plans (super manages; published readable by all)
    // ------------------------------------------------------------------
    match /plans/{planId} {
      allow read: if resource.data.published == true || isSuper();
      allow create: if isSuper();
      allow update: if isSuper();
      allow delete: if isSuper();
    }

    // ------------------------------------------------------------------
    // institutes (tenant roots)
    // ------------------------------------------------------------------
    match /institutes/{instituteId} {
      allow read: if canManageInstitute(instituteId);
      // Instances are created by Cloud Functions (Admin SDK).
      allow create: if false;
      // Owners may update own display/billing; super may manage status/limits.
      allow update: if canManageInstitute(instituteId);
      allow delete: if isSuper();

      // Staff members
      match /members/{uid} {
        allow read: if canManageInstitute(instituteId);
        allow create: if canManageInstitute(instituteId);
        allow update: if canManageInstitute(instituteId);
        allow delete: if canManageInstitute(instituteId);
      }
    }

    // ------------------------------------------------------------------
    // courses + content/quizzes/resources
    // ------------------------------------------------------------------
    match /courses/{courseId} {
      // Published courses are public; unpublished only to owner/super.
      allow read: if coursePublished(courseId) || canReadCourseAdmin(courseId);
      allow create: if canManageCourseData(request.resource.data);
      allow update: if isSuper() || (
        canManageCourseId(courseId)
        && request.resource.data.instituteId == myProfile().data.instituteId
      );
      allow delete: if canManageCourseId(courseId);

      match /content/{contentId} {
        allow read: if coursePublished(courseId) || canReadCourseAdmin(courseId);
        allow create: if canManageCourseId(courseId);
        allow update: if canManageCourseId(courseId);
        allow delete: if canManageCourseId(courseId);
      }

      match /quizzes/{quizId} {
        allow read: if signedIn() && (coursePublished(courseId) || canReadCourseAdmin(courseId));
        allow create: if canManageCourseId(courseId) && isValidQuizData(request.resource.data);
        allow update: if canManageCourseId(courseId) && isValidQuizData(request.resource.data);
        allow delete: if canManageCourseId(courseId);
      }

      match /resources/{resourceId} {
        allow read: if coursePublished(courseId) || canReadCourseAdmin(courseId);
        allow create: if canManageCourseId(courseId);
        allow update: if canManageCourseId(courseId);
        allow delete: if canManageCourseId(courseId);
      }
    }

    // ------------------------------------------------------------------
    // orders (ledger — function-only writes; scoped reads)
    // ------------------------------------------------------------------
    match /orders/{orderId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.buyerId
        || (isInstitute() && resource.data.instituteId == myProfile().data.instituteId)
        || isSuper()
      );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Unmatched webhook payloads
    match /rejectedEvents/{eventId} {
      allow read: if isSuper();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // payouts
    // ------------------------------------------------------------------
    match /payouts/{payoutId} {
      allow read: if isSuper() || (
        isInstitute() && resource.data.instituteId == myProfile().data.instituteId
      );
      allow create: if isSuper();
      allow update: if isSuper();
      allow delete: if isSuper();
    }

    // ------------------------------------------------------------------
    // enrollments
    // ------------------------------------------------------------------
    match /enrollments/{enrollmentId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.userId
        || isSuper()
        || canReadCourseAdmin(resource.data.courseId)
      );
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['id', 'userId', 'courseId', 'status', 'requestedAt', 'source']);
      // Approve / reject / revoke only by the course's institute admin (or super).
      allow update: if signedIn() && canReadCourseAdmin(resource.data.courseId);
      allow delete: if isSuper();
    }

    // ------------------------------------------------------------------
    // progress
    // ------------------------------------------------------------------
    match /progress/{progressId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.userId || isSuper());
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.keys().hasOnly(['id', 'userId', 'courseId', 'completedContentIds', 'updatedAt'])
        && request.resource.data.userId is string
        && request.resource.data.courseId is string
        && request.resource.data.completedContentIds is list
        && request.resource.data.completedContentIds.size() <= 1000
        && request.resource.data.updatedAt is timestamp;
      allow update: if signedIn()
        && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedContentIds', 'updatedAt'])
        && request.resource.data.completedContentIds is list
        && request.resource.data.completedContentIds.size() <= 1000
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isSuper();
    }

    // ------------------------------------------------------------------
    // quizAttempts / quizSessions (function-only writes; scoped reads)
    // ------------------------------------------------------------------
    match /quizAttempts/{attemptId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.userId
        || isSuper()
        || canReadCourseAdmin(resource.data.courseId)
      );
      allow create: if false;
      allow update: if isSuper() || canReadCourseAdmin(resource.data.courseId);
      allow delete: if isSuper();
    }

    match /quizSessions/{sessionId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.userId
        || isSuper()
        || canReadCourseAdmin(resource.data.courseId)
      );
      allow create: if false;
      allow update: if isSuper();
      allow delete: if isSuper();
    }
  }
}
