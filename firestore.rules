rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidQuizData(data) {
      return data is map
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.description is string
        && data.description.size() <= 2000
        && data.passPercentage is int
        && data.passPercentage >= 0
        && data.passPercentage <= 100
        && data.maxAttempts is int
        && data.maxAttempts >= 1
        && data.maxAttempts <= 100
        && data.randomizeQuestionOrder is bool
        && data.randomizeAnswerOrder is bool
        && data.questions is list
        && data.questions.size() >= 1
        && data.questions.size() <= 100
        && (!('timeLimit' in data) || (data.timeLimit is int && data.timeLimit >= 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Allow authenticated users to read/write their own user profile.
    // Admins can read any user profile (required for admin dashboards,
    // enrollment review, and analytics).
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student';
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt']);
    }

    // Allow anyone to read published courses; admins can create, update, and delete
    match /courses/{courseId} {
      allow read: if resource.data.published == true || (request.auth != null && isAdmin());
      allow create: if request.auth != null && isAdmin();
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();

      // Allow anyone to read course content for published courses; admins can manage
      match /content/{contentId} {
        allow read: if (
          get(/databases/$(database)/documents/courses/$(courseId)).data.published == true
        ) || (request.auth != null && isAdmin());
        allow create: if request.auth != null && isAdmin();
        allow update: if request.auth != null && isAdmin();
        allow delete: if request.auth != null && isAdmin();
      }

      // Admins manage quizzes; published quizzes are readable by authenticated learners
      match /quizzes/{quizId} {
        allow read: if request.auth != null && (
          isAdmin()
          || get(/databases/$(database)/documents/courses/$(courseId)).data.published == true
        );
        allow create: if request.auth != null && isAdmin() && isValidQuizData(request.resource.data);
        allow update: if request.auth != null && isAdmin() && isValidQuizData(request.resource.data);
        allow delete: if request.auth != null && isAdmin();
      }

      // Resources (study materials incl. flashcards) are managed by admins;
      // authenticated learners can read them for published courses.
      match /resources/{resourceId} {
        allow read: if request.auth != null && (
          isAdmin()
          || get(/databases/$(database)/documents/courses/$(courseId)).data.published == true
        );
        allow create, update, delete: if request.auth != null && isAdmin();
      }
    }

    // Allow authenticated users to read their own enrollments or if admin
    // Students may only create a PENDING enrollment for themselves; approval is admin-only
    match /enrollments/{enrollmentId} {
      allow read: if request.auth != null && (
        request.auth.uid == get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.userId
        || isAdmin()
      );
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.status == 'pending'
        && request.resource.data.id == enrollmentId
        && request.resource.data.keys().hasOnly(['id', 'userId', 'courseId', 'status', 'requestedAt']);
      allow update: if request.auth != null && isAdmin()
        && request.resource.data.keys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'enrolledAt']);
      allow delete: if request.auth != null && isAdmin();
    }

    // Allow authenticated users to track their own progress.
    // Field writes are restricted: only completedContentIds and updatedAt
    // may be modified, the array is size-capped, and the document must
    // belong to the authenticated user.
    match /progress/{progressId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.keys().hasOnly(['id', 'userId', 'courseId', 'completedContentIds', 'updatedAt'])
        && request.resource.data.userId is string
        && request.resource.data.courseId is string
        && request.resource.data.completedContentIds is list
        && request.resource.data.completedContentIds.size() <= 1000
        && request.resource.data.updatedAt is timestamp;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedContentIds', 'updatedAt'])
        && request.resource.data.completedContentIds is list
        && request.resource.data.completedContentIds.size() <= 1000
        && request.resource.data.updatedAt is timestamp;
      allow delete: if request.auth != null && isAdmin();
    }

    // Quiz attempts are written by server-side quiz actions only.
    match /quizAttempts/{attemptId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if false;
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }

    // Quiz sessions are created and completed by server-side quiz actions only.
    match /quizSessions/{sessionId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if false;
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }
  }
}