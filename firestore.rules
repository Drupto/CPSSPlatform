rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // True when the caller has granted access to the given course. Enrollment
    // documents are deterministically keyed `${uid}_${courseId}` by
    // requestEnrollment() in src/lib/course.ts — rules cannot run queries, so
    // access checks rely on that stable doc id. A missing `status` field
    // counts as approved: those are legacy docs created before the approval
    // system and represent already-granted access (mirrors
    // normalizeEnrollment()); client-created docs must have status ==
    // 'pending' (enforced by the /enrollments create rule), so a status-less
    // doc can only be legacy or admin-written. exists() guards the get() so
    // non-enrolled callers get a clean `false` instead of a missing-document
    // error. Callers must ensure request.auth != null (short-circuited).
    function hasEnrollmentFor(courseId) {
      return exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId))
        && (!('status' in get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)).data)
            || get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)).data.status == 'approved');
    }

    function isValidQuizData(data) {
      return data is map
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.description is string
        && data.description.size() <= 2000
        && data.passPercentage is int
        && data.passPercentage >= 0
        && data.passPercentage <= 100
        && data.maxAttempts is int
        && data.maxAttempts >= 1
        && data.maxAttempts <= 100
        && data.randomizeQuestionOrder is bool
        && data.randomizeAnswerOrder is bool
        && data.questions is list
        && data.questions.size() >= 1
        && data.questions.size() <= 100
        && (!('timeLimit' in data) || (data.timeLimit is int && data.timeLimit >= 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validates course content/resource documents (curriculum blocks and study
    // resources incl. flashcards). Applied to admin writes as defense-in-depth
    // so a compromised admin client cannot persist malformed documents.
    // `title`/`type`/`order` are required; `body`/`url` are optional in the
    // type model (CourseContentItem) so they are only checked when present —
    // this keeps legacy documents editable. `front`/`back` are required
    // non-empty strings for flashcards, mirroring the admin form validation.
    // Caps: title 200, body 50k, url 2048, front/back 5k — generous but bounded.
    // A non-empty `url` must be an https:// link: the student UI opens it in a
    // new tab, and scheme enforcement rules out javascript:/data: payloads.
    // (Empty string stays allowed — the data layer writes url: "" when absent.)
    function isValidContentData(data) {
      return data is map
        && data.type is string
        && data.type in ['text', 'video', 'document', 'link', 'flashcard', 'quiz']
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        // Quiz content items are ordered pointers into the course stream that
        // reference a quiz document (courses/{courseId}/quizzes/{quizId}) the
        // learn page launches inline. A quiz item MUST carry a non-empty
        // quizId; other types may not gain one accidentally (stale ids are
        // tolerated on legacy docs via the only-checked-when-present pattern).
        && (data.type != 'quiz' || (data.quizId is string && data.quizId.size() > 0 && data.quizId.size() <= 150))
        && (!('quizId' in data) || (data.quizId is string && data.quizId.size() <= 150))
        && (!('body' in data) || (data.body is string && data.body.size() <= 50000))
        && (!('url' in data) || (data.url is string
            && data.url.size() <= 2048
            && (data.url.size() == 0 || data.url.matches('^https://.+'))))
        && data.order is int
        && data.order >= 0
        && (data.type != 'flashcard'
            || (data.front is string
                && data.front.size() > 0
                && data.front.size() <= 5000
                && data.back is string
                && data.back.size() > 0
                && data.back.size() <= 5000));
    }

    // Allow authenticated users to read/write their own user profile.
    // Admins can read any user profile (required for admin dashboards,
    // enrollment review, and analytics).
    // Create is fully whitelisted to the exact shape createUserProfile() in
    // src/lib/course.ts writes (uid/email/displayName/role/createdAt/updatedAt,
    // role hardcoded to 'student' — admins are promoted out-of-band only).
    // Update allows only displayName + updatedAt; type checks are written so
    // legacy profiles (missing/null fields) still pass when a field is merely
    // carried through a merge update unchanged.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && request.resource.data.uid is string
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        && (!('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 100)
            || (('displayName' in resource.data)
                && request.resource.data.displayName == resource.data.displayName))
        && (!('updatedAt' in request.resource.data)
            || request.resource.data.updatedAt is timestamp
            || request.resource.data.updatedAt == resource.data.updatedAt);
    }

    // Allow anyone to read published courses; admins can create, update, and delete
    match /courses/{courseId} {
      allow read: if resource.data.published == true || (request.auth != null && isAdmin());
      allow create: if request.auth != null && isAdmin();
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();

      // Course content (curriculum blocks): authenticated learners can read
      // content of published courses; admins can manage. All client consumers
      // are authenticated (the learn page redirects anonymous visitors; public
      // pages read via server-side Admin SDK, which bypasses rules anyway).
      match /content/{contentId} {
        allow read: if request.auth != null && (
          isAdmin()
          || get(/databases/$(database)/documents/courses/$(courseId)).data.published == true
        );
        allow create: if request.auth != null && isAdmin() && isValidContentData(request.resource.data);
        allow update: if request.auth != null && isAdmin() && isValidContentData(request.resource.data);
        allow delete: if request.auth != null && isAdmin();
      }

      // Quizzes contain the answer key (correctAnswerIndex/explanation) —
      // reads are admin-only. Students fetch sanitized quizzes (answer key
      // stripped) via the getQuizForStudent callable, which enforces
      // authentication, publication, and approved enrollment server-side.
      // ⚠️ Deploy the functions BEFORE deploying this rule (the learn page
      // needs the callable to load quizzes).
      match /quizzes/{quizId} {
        allow read: if request.auth != null && isAdmin();
        allow create: if request.auth != null && isAdmin() && isValidQuizData(request.resource.data);
        allow update: if request.auth != null && isAdmin() && isValidQuizData(request.resource.data);
        allow delete: if request.auth != null && isAdmin();
      }

      // Resources (study materials incl. flashcards) are managed by admins and
      // are paid course material: reads require an approved enrollment in a
      // published course (or admin role). See hasEnrollmentFor() — rules
      // cannot run queries, so it relies on the deterministic
      // `${uid}_${courseId}` enrollment doc id. Writes are shape-validated
      // (see isValidContentData) — flashcard documents must carry non-empty
      // front/back content.
      match /resources/{resourceId} {
        allow read: if request.auth != null && (
          isAdmin()
          || (
            get(/databases/$(database)/documents/courses/$(courseId)).data.published == true
            && hasEnrollmentFor(courseId)
          )
        );
        allow create, update: if request.auth != null && isAdmin() && isValidContentData(request.resource.data);
        allow delete: if request.auth != null && isAdmin();
      }
    }

    // Allow authenticated users to read their own enrollments or if admin.
    // Students create a PENDING enrollment for themselves WITH their payment
    // details (submitted on the payment page); review/approval is admin-only.
    match /enrollments/{enrollmentId} {
      // NOTE: `resource.data.userId` (never a get() on the same document — a
      // get() cannot prove a list query is restricted, so the old self-get
      // version rejected every getEnrollmentsForUser(uid) query for students).
      // Split into get/list because a `get` on a NON-EXISTENT doc has
      // `resource == null`, so any `resource.data...` access errors → deny.
      // The pay page does getDoc(`${uid}_${courseId}`) to decide
      // create-vs-update, and first-time payers have no doc yet — without the
      // third `get` branch that read throws permission-denied, which surfaced
      // as "Could not submit your payment details. Please try again."
      // The prefix check is safe: enrollment ids are deterministically
      // `${uid}_${courseId}` (see submitPaymentRequest), and Auth UIDs are
      // alphanumeric so interpolation cannot inject regex.
      allow get: if request.auth != null && (
        isAdmin()
        || (resource != null && request.auth.uid == resource.data.userId)
        || (resource == null && enrollmentId.matches('^' + request.auth.uid + '_.*'))
      );
      // List queries must be provably restricted: only own docs (the client
      // always queries where("userId", "==", uid)) or admins.
      allow list: if request.auth != null && (
        request.auth.uid == resource.data.userId
        || isAdmin()
      );

      // Student submission from the payment page: one atomic write of the
      // pending enrollment + payment details. Field whitelist and type checks
      // mirror submitPaymentRequest() in src/lib/course.ts. The reference is
      // unverified user input — length-capped and display-only (the admin
      // matches it manually against their UPI/PayPal app). courseId and
      // requestedAt are type-capped too: the client sends serverTimestamp() /
      // plain strings, but a tampered client must not persist oversized maps
      // or corrupt sort keys into a document admins review.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.status == 'pending'
        && request.resource.data.id == enrollmentId
        && request.resource.data.keys().hasOnly(['id', 'userId', 'courseId', 'status', 'requestedAt', 'paymentMethod', 'paymentReference', 'paymentSubmittedAt'])
        && request.resource.data.userId is string
        && request.resource.data.courseId is string
        && request.resource.data.courseId.size() > 0
        && request.resource.data.courseId.size() <= 128
        && request.resource.data.requestedAt is timestamp
        && request.resource.data.paymentMethod in ['upi', 'paypal']
        && request.resource.data.paymentReference is string
        && request.resource.data.paymentReference.size() > 0
        && request.resource.data.paymentReference.size() <= 100
        && request.resource.data.paymentSubmittedAt is timestamp;

      // Exactly two legal update shapes:
      //
      // 1. ADMIN REVIEW — approve / reject / revoke stamps. Uses
      //    diff().affectedKeys() (NOT request.resource.data.keys()): a merge
      //    update carries the pre-existing fields (id, userId, courseId,
      //    requestedAt) in request.resource.data, so a keys().hasOnly(...)
      //    whitelist would deny every approval. `status` is constrained so
      //    admins can only ever move to approved/rejected.
      //
      // 2. STUDENT PAYMENT (RE)SUBMISSION — only on their own doc, only from
      //    pending/rejected (or legacy status-less docs, which pre-date the
      //    approval system — the client normalizes those to "approved" but
      //    they never went through payment, so the student must still be able
      //    to submit), only ever producing pending, only touching the
      //    payment fields (+ requestedAt refresh). Approved docs are
      //    untouchable by students, so a revoke is irreversible from the
      //    student side. Missing payment fields fail closed (error → deny).
      allow update: if request.auth != null && (
        (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'enrolledAt'])
          && request.resource.data.status in ['approved', 'rejected']
        )
        || (
          request.auth.uid == resource.data.userId
          && (!('status' in resource.data) || resource.data.status in ['pending', 'rejected'])
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['id', 'status', 'requestedAt', 'paymentMethod', 'paymentReference', 'paymentSubmittedAt'])
          && request.resource.data.id == enrollmentId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.paymentMethod in ['upi', 'paypal']
          && request.resource.data.paymentReference is string
          && request.resource.data.paymentReference.size() > 0
          && request.resource.data.paymentReference.size() <= 100
          && request.resource.data.paymentSubmittedAt is timestamp
          && request.resource.data.requestedAt is timestamp
        )
      );
      allow delete: if request.auth != null && isAdmin();
    }

    // Allow authenticated users to track their own progress.
    // Field writes are restricted: only completedContentIds and updatedAt
    // may be modified, the array is size-capped, and the document must
    // belong to the authenticated user.
    match /progress/{progressId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.keys().hasOnly(['id', 'userId', 'courseId', 'completedContentIds', 'updatedAt'])
        && request.resource.data.userId is string
        && request.resource.data.courseId is string
        && request.resource.data.completedContentIds is list
        && request.resource.data.completedContentIds.size() <= 1000
        && request.resource.data.updatedAt is timestamp;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedContentIds', 'updatedAt'])
        && request.resource.data.completedContentIds is list
        && request.resource.data.completedContentIds.size() <= 1000
        && request.resource.data.updatedAt is timestamp;
      allow delete: if request.auth != null && isAdmin();
    }

    // Per-user study state for the Resources dashboard (viewed documents,
    // flashcard "known/review" states, last-studied resume card). One document
    // per user+course holds map fields keyed by resource id. Same ownership
    // model as /progress: students may only touch their own document, and
    // writes are restricted to the whitelisted fields with size caps sized
    // for multi-thousand-card decks.
    match /resourceProgress/{progressId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.keys().hasOnly(['id', 'userId', 'courseId', 'viewedResourceIds', 'flashcardStates', 'lastStudiedCardId', 'lastStudiedAt', 'updatedAt'])
        && request.resource.data.userId is string
        && request.resource.data.courseId is string
        && request.resource.data.viewedResourceIds is map
        && request.resource.data.viewedResourceIds.size() <= 5000
        && request.resource.data.flashcardStates is map
        && request.resource.data.flashcardStates.size() <= 5000
        && (request.resource.data.lastStudiedCardId == null || request.resource.data.lastStudiedCardId is string)
        && (request.resource.data.lastStudiedAt == null || request.resource.data.lastStudiedAt is timestamp)
        && request.resource.data.updatedAt is timestamp;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedResourceIds', 'flashcardStates', 'lastStudiedCardId', 'lastStudiedAt', 'updatedAt'])
        && request.resource.data.viewedResourceIds is map
        && request.resource.data.viewedResourceIds.size() <= 5000
        && request.resource.data.flashcardStates is map
        && request.resource.data.flashcardStates.size() <= 5000
        && (request.resource.data.lastStudiedCardId == null || request.resource.data.lastStudiedCardId is string)
        && (request.resource.data.lastStudiedAt == null || request.resource.data.lastStudiedAt is timestamp)
        && request.resource.data.updatedAt is timestamp;
      allow delete: if request.auth != null && isAdmin();
    }

    // Quiz attempts are written by server-side quiz actions only.
    match /quizAttempts/{attemptId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if false;
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }

    // Quiz sessions are created and completed by server-side quiz actions only.
    match /quizSessions/{sessionId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if false;
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }

    // Checklist lead-magnet enquiries from the public /checklist page.
    // Visitors are anonymous, so `create` is open but strictly validated:
    // exact key set, per-field types, size caps, a fixed `source` tag, and an
    // email format check. Reads/updates/deletes stay admin-only.
    match /checklistEnquiries/{enquiryId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'challenge', 'source', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.challenge is string
        && request.resource.data.challenge.size() <= 1000
        && request.resource.data.source == 'checklist-landing'
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if isAdmin();
    }
  }
}