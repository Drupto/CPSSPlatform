rules_version = '2';

// Firebase Storage Rules
service firebase.storage {
  match /b/{bucket}/o {
    // Course assets: institute staff / super can write; authenticated users can read
    match /courses/{courseId}/{asset} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && isCourseManager(firestore.get(/databases/(default)/documents/courses/$(courseId)));
    }
  }

  // Default deny
  match /{allPaths=**} {
    allow read, write: if false;
  }

  function isCourseManager(course) {
    let uid = request.auth.uid;
    let profile = firestore.get(/databases/(default)/documents/users/$(uid));
    // Super can manage any course.
    if (profile.data.role == 'super') {
      return true;
    }
    // Institute staff can manage courses that belong to their own institute.
    return profile.data.role == 'institute'
      && profile.data.instituteId != null
      && course.data.instituteId == profile.data.instituteId;
  }
}