# ---------------------------------------------------------------------------
# DruptoLMS — Cloud Functions environment example.
# Copy to functions/.env for local emulation, and set the same variables via
# `firebase functions:secrets:set` (or your CI secret store) for production.
# 🔴 NEVER commit real secret values.
# ---------------------------------------------------------------------------

# Razorpay keys. Get from https://dashboard.razorpay.com/app/keys
# Use rzp_test_* during development, rzp_live_* in production.
# ⚠️ key mode (test vs live) MUST match NEXT_PUBLIC_RAZORPAY_KEY_ID in the app.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# (Optional) Override the Firestore region if different from us-central1.
# FIRESTORE_EMULATOR_HOST=localhost:8080